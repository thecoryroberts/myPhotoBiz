@model MyPhotoBiz.ViewModels.SystemSettingsViewModel

@{
    ViewBag.Title = "System Settings";
    ViewBag.PageTitle = "System Settings";
    ViewBag.SubTitle = "Settings";
    ViewBag.SubTitleUrl = Url.Action("Index", "Settings");
    ViewBag.Icon = "ti-adjustments";
    ViewBag.Color = "dark";
    ViewBag.BackUrl = Url.Action("Index", "Settings");
    ViewBag.Purpose = "Configure system settings.";
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <form asp-action="System" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Regional Settings -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="ti ti-world me-2"></i>Regional Settings
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Timezone" class="form-label"></label>
                                <select asp-for="Timezone" class="form-select">
                                    @foreach (var tz in Model.AvailableTimezones)
                                    {
                                        <option value="@tz.Id">@tz.DisplayName</option>
                                    }
                                </select>
                                <small class="text-muted">Used for scheduling and displaying dates/times</small>
                                <span asp-validation-for="Timezone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DateFormat" class="form-label"></label>
                                <select asp-for="DateFormat" class="form-select">
                                    @foreach (var format in Model.AvailableDateFormats)
                                    {
                                        <option value="@format" selected="@(format == Model.DateFormat)">
                                            @format - @DateTime.Now.ToString(format)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="DateFormat" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TimeFormat" class="form-label"></label>
                                <select asp-for="TimeFormat" class="form-select">
                                    @foreach (var format in Model.AvailableTimeFormats)
                                    {
                                        <option value="@format">
                                            @format - @DateTime.Now.ToString(format)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="TimeFormat" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Security Settings -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="ti ti-shield-lock me-2"></i>Security Settings
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input asp-for="EnableTwoFactorAuth" class="form-check-input" type="checkbox">
                                    <label asp-for="EnableTwoFactorAuth" class="form-check-label">Enable Two-Factor Authentication</label>
                                </div>
                                <small class="text-muted">Require 2FA for admin users</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SessionTimeoutMinutes" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="SessionTimeoutMinutes" class="form-control" type="number" min="5" max="480" />
                                    <span class="input-group-text">minutes</span>
                                </div>
                                <small class="text-muted">Auto-logout after inactivity</small>
                                <span asp-validation-for="SessionTimeoutMinutes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="ti ti-x me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-check me-1"></i>Save Changes
                    </button>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Current Settings -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="ti ti-info-circle me-2"></i>Current Settings
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small">Current Time</label>
                            @{
                                TimeZoneInfo userTimeZone;
                                DateTime userTime;
                                try
                                {
                                    userTimeZone = TimeZoneInfo.FindSystemTimeZoneById(Model.Timezone);
                                    userTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, userTimeZone);
                                }
                                catch (TimeZoneNotFoundException)
                                {
                                    userTimeZone = TimeZoneInfo.Utc;
                                    userTime = DateTime.UtcNow;
                                }
                            }
                            <p class="mb-0 fw-medium">@userTime.ToString(Model.TimeFormat) (@Model.Timezone)</p>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Current Date</label>
                            <p class="mb-0 fw-medium">@userTime.ToString(Model.DateFormat)</p>
                        </div>
                        <hr>
                        <div class="d-flex gap-2">
                            @if (Model.EnableTwoFactorAuth)
                            {
                                <span class="badge bg-success"><i class="ti ti-shield-check me-1"></i>2FA Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="ti ti-shield-off me-1"></i>2FA Disabled</span>
                            }
                            <span class="badge bg-info">@Model.SessionTimeoutMinutes min timeout</span>
                        </div>
                    </div>
                </div>

                <!-- Tips -->
                <div class="card">
                    <div class="card-body">
                        <h6><i class="ti ti-bulb me-2"></i>Tips</h6>
                        <ul class="small text-muted mb-0 ps-3">
                            <li class="mb-1">Set your timezone to ensure correct scheduling</li>
                            <li class="mb-1">Date formats vary by region (US: MM/DD, EU: DD/MM)</li>
                            <li class="mb-1">2FA adds an extra layer of account security</li>
                            <li class="mb-1">Shorter session timeouts are more secure</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
