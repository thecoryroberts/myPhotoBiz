@model MyPhotoBiz.Models.ContractVariable

@{
    ViewBag.Title = "Create Variable";
    ViewBag.PageTitle = "Create Variable";
    ViewBag.SubTitle = "Contract Variables";
    ViewBag.SubTitleUrl = Url.Action("Index", "ContractVariables");
    ViewBag.Icon = "ti-variable";
    ViewBag.Color = "info";
    ViewBag.Purpose = "Create a new custom contract variable.";
    ViewBag.BackUrl = Url.Action("Index", "ContractVariables");
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Variable Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">{{</span>
                                <input asp-for="Name" class="form-control" placeholder="e.g., CompanyName" />
                                <span class="input-group-text">}}</span>
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <small class="text-muted">Use only letters and numbers, starting with a letter. This will create the placeholder <code id="placeholder-preview">{{VariableName}}</code></small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <input asp-for="Description" class="form-control" placeholder="Brief description of what this variable represents" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DefaultValue" class="form-label">Default Value</label>
                            <input asp-for="DefaultValue" class="form-control" placeholder="Value to use if not specified" />
                            <span asp-validation-for="DefaultValue" class="text-danger"></span>
                            <small class="text-muted">This value will be used when no specific value is set for a contract.</small>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                            <small class="text-muted">Inactive variables won't be replaced in contracts.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-plus me-1"></i> Create Variable
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="ti ti-help me-2"></i>Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="text-muted small mb-0">
                        <li class="mb-2">Variable names are case-insensitive (<code>{{CompanyName}}</code> and <code>{{companyname}}</code> are the same)</li>
                        <li class="mb-2">Use descriptive names like <code>{{WeddingVenue}}</code> or <code>{{SessionDeposit}}</code></li>
                        <li class="mb-2">You can set default values that apply when no specific value is provided</li>
                        <li>Values can be customized per-contract when creating or editing contracts</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var nameInput = document.getElementById('Name');
            var preview = document.getElementById('placeholder-preview');

            nameInput.addEventListener('input', function() {
                var value = this.value.trim() || 'VariableName';
                preview.textContent = '{{' + value + '}}';
            });
        });
    </script>
}
