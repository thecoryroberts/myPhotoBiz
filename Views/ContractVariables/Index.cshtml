@model IEnumerable<MyPhotoBiz.Models.ContractVariable>

@{
    ViewBag.Title = "Contract Variables";
    ViewBag.PageTitle = "Contract Variables";
    ViewBag.Icon = "ti-variable";
    ViewBag.Color = "info";
    ViewBag.Purpose = "Manage custom variables for use in contract templates.";
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="row">
        <div class="col-lg-8">
            <div data-table data-table-rows-per-page="10" class="card">
                <div class="card-header border-light justify-content-between">
                    <div class="d-flex gap-2">
                        <div class="app-search">
                            <input data-table-search type="text" class="form-control" placeholder="Search variables...">
                            <i data-lucide="search" class="app-search-icon text-muted"></i>
                        </div>
                        <a asp-action="Create" class="btn btn-primary rounded-circle btn-icon"
                           aria-label="Create new variable">
                            <i class="ti ti-plus fs-lg" aria-hidden="true"></i>
                        </a>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="me-2 fw-semibold">Filter By:</span>
                        <div class="app-search">
                            <select data-table-filter="Status" class="form-select form-control my-1 my-md-0">
                                <option value="">All Statuses</option>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <i data-lucide="toggle-left" class="app-search-icon text-muted"></i>
                        </div>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="card-body text-center py-5">
                        <div class="empty-state">
                            <div class="empty-state-icon bg-info-subtle rounded-circle mx-auto mb-4" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                                <i class="ti ti-variable fs-1 text-info"></i>
                            </div>
                            <h4 class="mb-2">No custom variables yet</h4>
                            <p class="text-muted mb-4">Create custom variables to use in your contract templates beyond the built-in ones.</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="ti ti-plus me-1"></i> Create Your First Variable
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-custom table-centered table-hover w-100 mb-0">
                            <thead class="bg-light align-middle bg-opacity-25 thead-sm">
                                <tr class="text-uppercase fs-xxs">
                                    <th scope="col" data-table-sort="name">Variable</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Default Value</th>
                                    <th scope="col" data-table-filter-column="Status">Status</th>
                                    <th scope="col" class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var variable in Model)
                                {
                                    <tr>
                                        <td>
                                            <h5 class="m-0">
                                                <code class="text-primary">@variable.Placeholder</code>
                                            </h5>
                                        </td>
                                        <td>
                                            <span class="text-muted">
                                                @(string.IsNullOrEmpty(variable.Description) ? "—" : variable.Description)
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(variable.DefaultValue))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">@variable.DefaultValue</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td data-filter-value="@(variable.IsActive ? "Active" : "Inactive")">
                                            @if (variable.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    <i class="ti ti-check me-1" aria-hidden="true"></i>Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">
                                                    <i class="ti ti-minus me-1" aria-hidden="true"></i>Inactive
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                <a asp-action="Edit" asp-route-id="@variable.Id"
                                                   class="btn btn-sm btn-outline-secondary btn-icon"
                                                   title="Edit"
                                                   aria-label="Edit variable @variable.Name">
                                                    <i class="ti ti-edit" aria-hidden="true"></i>
                                                </a>
                                                <form asp-action="ToggleActive" asp-route-id="@variable.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary btn-icon"
                                                            title="@(variable.IsActive ? "Deactivate" : "Activate")"
                                                            aria-label="@(variable.IsActive ? "Deactivate" : "Activate") variable @variable.Name">
                                                        <i class="ti ti-@(variable.IsActive ? "eye-off" : "eye")" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary btn-icon delete-btn"
                                                        title="Delete"
                                                        aria-label="Delete variable @variable.Name"
                                                        data-variable-id="@variable.Id"
                                                        data-variable-name="@variable.Name">
                                                    <i class="ti ti-trash" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer border-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <div data-table-pagination-info="variables"></div>
                            <div data-table-pagination></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="ti ti-info-circle me-2"></i>Built-in Variables</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">These system variables are automatically available in all contracts:</p>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td><code>{{ClientName}}</code></td><td class="text-muted small">Client's full name</td></tr>
                                <tr><td><code>{{ClientEmail}}</code></td><td class="text-muted small">Client's email</td></tr>
                                <tr><td><code>{{ClientPhone}}</code></td><td class="text-muted small">Client's phone</td></tr>
                                <tr><td><code>{{ShootTitle}}</code></td><td class="text-muted small">Photo shoot title</td></tr>
                                <tr><td><code>{{ShootDate}}</code></td><td class="text-muted small">Scheduled date</td></tr>
                                <tr><td><code>{{EventDate}}</code></td><td class="text-muted small">Event date (alias)</td></tr>
                                <tr><td><code>{{Location}}</code></td><td class="text-muted small">Shoot location</td></tr>
                                <tr><td><code>{{PhotographerName}}</code></td><td class="text-muted small">Photographer name</td></tr>
                                <tr><td><code>{{CurrentDate}}</code></td><td class="text-muted small">Current date</td></tr>
                                <tr><td><code>{{GuardianName}}</code></td><td class="text-muted small">Guardian for minors</td></tr>
                                <tr><td><code>{{PackageName}}</code></td><td class="text-muted small">Service package</td></tr>
                                <tr><td><code>{{Duration}}</code></td><td class="text-muted small">Shoot duration</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/custom-table.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.delete-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var variableId = this.getAttribute('data-variable-id');
                    var variableName = this.getAttribute('data-variable-name');

                    confirmDelete('variable {{' + variableName + '}}', function() {
                        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (!token) {
                            showError('Security token missing. Please refresh the page.');
                            return;
                        }

                        var formData = new FormData();
                        formData.append('__RequestVerificationToken', token);

                        fetch('@Url.Action("Delete", "ContractVariables")/' + variableId, {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => {
                            if (response.ok) {
                                showSuccess('Variable deleted successfully!');
                                setTimeout(() => window.location.reload(), 1500);
                            } else {
                                showError('Failed to delete variable');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showError('An error occurred while deleting the variable');
                        });
                    });
                });
            });
        });
    </script>
}
