@model MyPhotoBiz.Models.ContractVariable

@{
    ViewBag.Title = "Edit Variable";
    ViewBag.PageTitle = "Edit Variable";
    ViewBag.SubTitle = "Contract Variables";
    ViewBag.SubTitleUrl = Url.Action("Index", "ContractVariables");
    ViewBag.Icon = "ti-variable";
    ViewBag.Color = "info";
    ViewBag.Purpose = $"Edit the {Model.Placeholder} variable.";
    ViewBag.BackUrl = Url.Action("Index", "ContractVariables");
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Variable Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">{{</span>
                                <input asp-for="Name" class="form-control" placeholder="e.g., CompanyName" />
                                <span class="input-group-text">}}</span>
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <small class="text-muted">Use only letters and numbers, starting with a letter. Placeholder: <code id="placeholder-preview">@Model.Placeholder</code></small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <input asp-for="Description" class="form-control" placeholder="Brief description of what this variable represents" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DefaultValue" class="form-label">Default Value</label>
                            <input asp-for="DefaultValue" class="form-control" placeholder="Value to use if not specified" />
                            <span asp-validation-for="DefaultValue" class="text-danger"></span>
                            <small class="text-muted">This value will be used when no specific value is set for a contract.</small>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                            <small class="text-muted">Inactive variables won't be replaced in contracts.</small>
                        </div>

                        <hr />

                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <small class="text-muted">Created: @Model.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</small>
                            </div>
                            <div class="col-sm-6 text-sm-end">
                                <small class="text-muted">Updated: @Model.UpdatedDate.ToString("MMM dd, yyyy h:mm tt")</small>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="ti ti-help me-2"></i>Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="text-muted small mb-0">
                        <li class="mb-2">Changing the variable name will affect all templates using it</li>
                        <li class="mb-2">Existing contracts will keep their stored values</li>
                        <li class="mb-2">Deactivating a variable won't delete stored values</li>
                        <li>Consider the impact before renaming widely-used variables</li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0"><i class="ti ti-alert-triangle me-2"></i>Danger Zone</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">Deleting this variable will remove it from all contracts.</p>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this variable? This action cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="ti ti-trash me-1"></i> Delete Variable
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var nameInput = document.getElementById('Name');
            var preview = document.getElementById('placeholder-preview');

            nameInput.addEventListener('input', function() {
                var value = this.value.trim() || 'VariableName';
                preview.textContent = '{{' + value + '}}';
            });
        });
    </script>
}
