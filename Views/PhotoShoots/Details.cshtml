@using MyPhotoBiz.Enums
@using MyPhotoBiz.Models;

@model PhotoShoot
@{
    ViewBag.Title = Model.Title;
    ViewBag.PageTitle = "Photo Shoot Details";
    ViewBag.SubTitle = "Photo Shoots";
    ViewBag.SubTitleUrl = Url.Action("Index", "PhotoShoots");
    ViewBag.Icon = "ti-camera";
    ViewBag.Color = "warning";
    ViewBag.BackUrl = Url.Action("Index", "PhotoShoots");
    
    ViewBag.Purpose = "View photo shoot details.";

    var hasLocation = !string.IsNullOrWhiteSpace(Model.Location);
    var encodedLocation = hasLocation ? Uri.EscapeDataString(Model.Location) : string.Empty;
    var mapEmbedUrl = hasLocation
        ? $"https://www.google.com/maps?q={encodedLocation}&output=embed"
        : string.Empty;
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>@Model.Title</h4>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-controller="Albums" asp-action="Create" asp-route-photoShootId="@Model.Id" class="btn btn-sm btn-success">
                                <i class="fas fa-plus"></i> Add Album
                            </a>
                        </div>
                    }
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Client:</strong></div>
                        <div class="col-sm-9">@Model.ClientProfile?.User?.FirstName @Model.ClientProfile?.User?.LastName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Start Date & Time:</strong></div>
                        <div class="col-sm-9">@Model.ScheduledDate.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>End Date & Time:</strong></div>
                        <div class="col-sm-9">@Model.EndTime.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Duration:</strong></div>
                        <div class="col-sm-9">@Model.DurationHours hours @(Model.DurationMinutes > 0 ? $"{Model.DurationMinutes} minutes" : "")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Location:</strong></div>
                        <div class="col-sm-9">@Model.Location</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Status:</strong></div>
                        <div class="col-sm-9">
                        <span class="badge text-bg-@(Model.Status == PhotoShootStatus.Completed ? "success" : Model.Status == PhotoShootStatus.Scheduled ? "primary" : Model.Status == PhotoShootStatus.InProgress ? "warning" : "secondary")">
                                @Model.Status
                            </span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong>Price:</strong></div>
                        <div class="col-sm-9">@Model.Price.ToString("C")</div>
                    </div>
                    @if (Model.ServicePackage != null)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Package:</strong></div>
                            <div class="col-sm-9">
                                <span class="badge bg-info text-dark me-1">@Model.ServicePackage.Category</span>
                                @Model.ServicePackage.Name
                                @if (Model.ServicePackage.HasDiscount)
                                {
                                    <span class="badge bg-success ms-1">@Model.ServicePackage.DiscountPercentage% off</span>
                                }
                            </div>
                        </div>
                    }
                    @if (Model.BookingRequest != null)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Booking Ref:</strong></div>
                            <div class="col-sm-9">
                                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.BookingRequestId">
                                    @Model.BookingRequest.BookingReference
                                </a>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-3"><strong>Description:</strong></div>
                            <div class="col-sm-9">@Model.Description</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    <div class="col-md-4">
        @if (hasLocation)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-map-marked-alt me-2"></i>Location Map</h5>
                </div>
                <div class="card-body">
                    <div class="ratio ratio-16x9 rounded overflow-hidden border">
                        <iframe
                            src="@mapEmbedUrl"
                            title="Map for @Model.Location"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            allowfullscreen>
                        </iframe>
                    </div>
                    <p class="text-muted small mb-0 mt-2">@Model.Location</p>
                </div>
            </div>
        }

        @if (Model.ServicePackage != null)
        {
            <div class="card mb-3">
                <div class="card-header bg-info bg-opacity-10">
                    <h5 class="mb-0"><i class="ti ti-package me-2"></i>Package Details</h5>
                </div>
                <div class="card-body">
                    <h6 class="card-title">@Model.ServicePackage.Name</h6>
                    @if (!string.IsNullOrEmpty(Model.ServicePackage.Description))
                    {
                        <p class="text-muted small">@Model.ServicePackage.Description</p>
                    }
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="ti ti-clock text-primary me-2"></i>
                            @Model.ServicePackage.DurationHours hours session
                        </li>
                        @if (Model.ServicePackage.IncludedPhotos > 0)
                        {
                            <li class="mb-2">
                                <i class="ti ti-photo text-primary me-2"></i>
                                @Model.ServicePackage.IncludedPhotos edited photos
                            </li>
                        }
                        @if (Model.ServicePackage.IncludesDigitalGallery)
                        {
                            <li class="mb-2">
                                <i class="ti ti-device-desktop text-success me-2"></i>
                                Digital gallery included
                            </li>
                        }
                        @if (Model.ServicePackage.IncludesPrints && Model.ServicePackage.NumberOfPrints > 0)
                        {
                            <li class="mb-2">
                                <i class="ti ti-printer text-success me-2"></i>
                                @Model.ServicePackage.NumberOfPrints prints included
                            </li>
                        }
                        @if (Model.ServicePackage.IncludesAlbum)
                        {
                            <li class="mb-2">
                                <i class="ti ti-book text-success me-2"></i>
                                Photo album included
                            </li>
                        }
                        @if (Model.ServicePackage.NumberOfLocations > 1)
                        {
                            <li class="mb-2">
                                <i class="ti ti-map-pin text-primary me-2"></i>
                                Up to @Model.ServicePackage.NumberOfLocations locations
                            </li>
                        }
                        @if (Model.ServicePackage.OutfitChanges > 0)
                        {
                            <li class="mb-2">
                                <i class="ti ti-shirt text-primary me-2"></i>
                                @Model.ServicePackage.OutfitChanges outfit changes
                            </li>
                        }
                    </ul>
                    @if (Model.ServicePackage.FeaturesList.Any())
                    {
                        <hr class="my-2">
                        <small class="text-muted">Additional features:</small>
                        <ul class="small mb-0">
                            @foreach (var feature in Model.ServicePackage.FeaturesList)
                            {
                                <li>@feature</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h5>Albums</h5>
            </div>
            <div class="card-body">
                @if (Model.Albums.Any())
                {
                    <div class="list-group">
                        @foreach (var album in Model.Albums)
                        {
                            <a asp-controller="Albums" asp-action="Details" asp-route-id="@album.Id" class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@album.Name</h6>
                                    <small>@album.Photos.Count photos</small>
                                </div>
                                @if (!string.IsNullOrEmpty(album.Description))
                                {
                                    <p class="mb-1">@album.Description</p>
                                }
                                <small>Created @album.CreatedDate.ToString("MMM dd, yyyy")</small>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No albums created yet.</p>
                }
            </div>
        </div>
    </div>
</div>
</div>
