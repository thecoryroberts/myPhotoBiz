@model IEnumerable<MyPhotoBiz.Models.QuestionnaireAssignment>

@{
    ViewData["Title"] = "My Questionnaires";
    ViewBag.Purpose = "View and download your assigned questionnaires.";
    ViewBag.Title = "My Questionnaires";
    ViewBag.PageTitle = "My Questionnaires";
    ViewBag.Icon = "ti-clipboard-text";
    ViewBag.Color = "info";
}

@functions {
    string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue) return "";
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes.Value / 1024.0).ToString("0.0") + " KB";
        return (bytes.Value / (1024.0 * 1024.0)).ToString("0.0") + " MB";
    }
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="row">
        <div class="col-12">
            @if (Model == null || !Model.Any())
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="ti ti-clipboard-text" style="font-size: 64px; color: #ccc;"></i>
                        <h4 class="mt-3 text-muted">No Questionnaires Assigned</h4>
                        <p class="text-muted">You don't have any questionnaires assigned to you yet.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var assignment in Model)
                    {
                        <div class="col-lg-6 col-xl-4 mb-4">
                            <div class="card h-100">
                                <div class="card-header d-flex align-items-center">
                                    @if (assignment.QuestionnaireTemplate?.HasDocument == true)
                                    {
                                        <div
                                            class="avatar avatar-md @(assignment.QuestionnaireTemplate.DocumentType == "pdf" ? "bg-danger-subtle" : "bg-primary-subtle") me-3">
                                            <span
                                                class="avatar-title @(assignment.QuestionnaireTemplate.DocumentType == "pdf" ? "text-danger" : "text-primary") rounded">
                                                <i
                                                class="ti @(assignment.QuestionnaireTemplate.DocumentType == "pdf" ? "ti-file-type-pdf" : "ti-file-type-doc") fs-4"></i>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="avatar avatar-md bg-info-subtle me-3">
                                            <span class="avatar-title text-info rounded">
                                                <i class="ti ti-clipboard-text fs-4"></i>
                                            </span>
                                        </div>
                                    }
                                    <div>
                                        <h5 class="card-title mb-0">@assignment.QuestionnaireTemplate?.Name</h5>
                                        @if (!string.IsNullOrWhiteSpace(assignment.QuestionnaireTemplate?.Category))
                                        {
                                            <small class="text-muted">@assignment.QuestionnaireTemplate.Category</small>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrWhiteSpace(assignment.QuestionnaireTemplate?.Description))
                                    {
                                        <p class="text-muted mb-3">@assignment.QuestionnaireTemplate.Description</p>
                                    }

                                    <div class="mb-3">
                                        @if (assignment.Status == MyPhotoBiz.Models.QuestionnaireAssignmentStatus.Completed)
                                        {
                                            <span class="badge bg-success"><i class="ti ti-check me-1"></i>Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="ti ti-clock me-1"></i>Pending</span>
                                        }
                                    </div>

                                    <ul class="list-unstyled text-muted small mb-0">
                                        @if (assignment.DueDate.HasValue)
                                        {
                                            <li class="mb-1">
                                                <i class="ti ti-calendar me-1"></i>
                                                <strong>Due:</strong> @assignment.DueDate.Value.ToString("MMMM dd, yyyy")
                                            </li>
                                        }
                                        @if (assignment.Status == MyPhotoBiz.Models.QuestionnaireAssignmentStatus.Completed &&
                                                                        assignment.CompletedDate.HasValue)
                                        {
                                            <li class="mb-1">
                                                <i class="ti ti-check me-1"></i>
                                                <strong>Completed:</strong> @assignment.CompletedDate.Value.ToString("MMMM dd, yyyy")
                                            </li>
                                        }
                                        <li class="mb-1">
                                            <i class="ti ti-clock me-1"></i>
                                            <strong>Assigned:</strong> @assignment.AssignedDate.ToString("MMMM dd, yyyy")
                                        </li>
                                        @if (assignment.QuestionnaireTemplate?.HasDocument == true)
                                        {
                                            <li>
                                                <i class="ti ti-file me-1"></i>
                                                <strong>File:</strong> @assignment.QuestionnaireTemplate.OriginalFileName
                                                <span
                                                class="text-muted">(@FormatFileSize(assignment.QuestionnaireTemplate.FileSize))</span>
                                            </li>
                                        }
                                    </ul>

                                </div>
                                <div class="card-footer bg-transparent">
                                    <div>
                                        @if
                                            (!string.IsNullOrWhiteSpace(assignment.QuestionnaireTemplate?.QuestionText))
                                                {
                                                    <div class="alert alert-info mt-3 mb-0">
                                                        <i class="ti ti-info-circle me-1"></i>
                                                        This questionnaire has text-based questions. Use the
                                                        <strong>Answer Questions</strong> button to submit your responses.
                                                    </div>
                                                }
                                    </div>
                                         <div class="d-flex gap-2"> 
                                        @if (!string.IsNullOrWhiteSpace(assignment.QuestionnaireTemplate?.QuestionText))
                                        {
                                            <a asp-action="AnswerQuestionnaire" asp-route-id="@assignment.Id"
                                                   class="btn btn-primary flex-grow-1">
                                                <i class="ti ti-edit me-1"></i>
                                                @(assignment.Status == MyPhotoBiz.Models.QuestionnaireAssignmentStatus.Completed ?
                                                "View / Edit Answers" : "Answer Questions")
                                            </a>
                                        }
                                        @if (assignment.QuestionnaireTemplate?.HasDocument == true)
                                        {
                                            <a asp-action="DownloadQuestionnaire" asp-route-id="@assignment.Id"
                                                   class="btn btn-outline-primary flex-grow-1">
                                                <i class="ti ti-download me-1"></i> Download
                                            </a>
                                        }
                                        @if (assignment.QuestionnaireTemplate?.HasDocument == true &&
                                                                        string.IsNullOrWhiteSpace(assignment.QuestionnaireTemplate?.QuestionText))
                                        {
                                            @if (assignment.Status != MyPhotoBiz.Models.QuestionnaireAssignmentStatus.Completed)
                                            {
                                                <form asp-action="MarkQuestionnaireComplete" asp-route-id="@assignment.Id"
                                                      method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success" title="Mark as Complete">
                                                        <i class="ti ti-check"></i>
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>


                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>