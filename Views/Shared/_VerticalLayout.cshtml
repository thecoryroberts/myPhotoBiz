<!DOCTYPE html>

@inject MyPhotoBiz.Services.IAppSettingsService AppSettingsService
@using MyPhotoBiz.Services
@{
    var html_attributes = ViewBag.HTMLAttributes ?? "";
    var html_class = ViewBag.HTMLClass ?? "";
    var data_skin = ViewBag.DataSkin ?? "modern"; // default to modern
    ViewBag.Purpose = "Shared layout/partial (navigation, scripts, common UI).";

    var settings = AppSettingsService.GetCachedSettings();

    // Pre-compute RGB triplets and darkened variants for CSS variable overrides
    var primaryRgb = ColorContrastService.HexToRgbString(settings.PrimaryColor);
    var secondaryRgb = ColorContrastService.HexToRgbString(settings.SecondaryColor);
    var successRgb = ColorContrastService.HexToRgbString(settings.SuccessColor);
    var warningRgb = ColorContrastService.HexToRgbString(settings.WarningColor);
    var dangerRgb = ColorContrastService.HexToRgbString(settings.DangerColor);

    var primaryDark = ColorContrastService.DarkenHex(settings.PrimaryColor);
    var secondaryDark = ColorContrastService.DarkenHex(settings.SecondaryColor);
    var successDark = ColorContrastService.DarkenHex(settings.SuccessColor);
    var warningDark = ColorContrastService.DarkenHex(settings.WarningColor);
    var dangerDark = ColorContrastService.DarkenHex(settings.DangerColor);
}

<html lang="en" class="@html_class" data-skin="@data_skin" @html_attributes>

<head>
    @await Html.PartialAsync("~/Views/Shared/Partials/_TitleMeta.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_HeadCSS.cshtml")
    @RenderSection("styles", false)
</head>

    <body>

        <div class="wrapper">

            <!-- Skip to main content link for keyboard navigation -->
            <a href="#main-content" class="visually-hidden-focusable bg-primary text-white p-2 skip-link">Skip to main content</a>
            @await Html.PartialAsync("~/Views/Shared/Partials/_TopBar.cshtml")
            @await Html.PartialAsync("~/Views/Shared/Partials/_SideNav.cshtml")
            <div class="content-page" role="main" id="main-content" aria-label="Main content">
                @RenderBody()
                @await Html.PartialAsync("~/Views/Shared/Partials/_Footer.cshtml")
            </div>

            <!-- Footer Scripts -->
            @await Html.PartialAsync("~/Views/Shared/Partials/_FooterScripts.cshtml")

            <!--  Bootstrap Toasts and Confirmation Helpers -->
            @await Html.PartialAsync("~/Views/Shared/Partials/_Toasts.cshtml")

            <!-- Global Search Modal -->
            @await Html.PartialAsync("~/Views/Shared/Partials/_GlobalSearch.cshtml")

        @RenderSection("scripts", required: false)
    </div>

    </body>

</html>
