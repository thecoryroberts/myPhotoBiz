@{
    var title = ViewBag.Title as string ?? (ViewData["Title"] as string) ?? "Page";
    var subtitle = ViewBag.SubTitle as string;
    var subtitleUrl = ViewBag.SubTitleUrl as string;
    var icon = ViewBag.Icon as string ?? "ti ti-file";
    var purpose = ViewBag.Purpose as string;
}

<div class="row mb-4">
    <div class="col-md-8 col-12 mb-2 mb-md-0">
        <div class="d-flex align-items-center gap-2">
            <span class="avatar avatar-sm bg-label-primary rounded-circle d-inline-flex align-items-center justify-content-center">
                <i class="@icon"></i>
            </span>
            <div>
                <h4 class="fw-bold py-0 mb-0">@title</h4>
                @if (!string.IsNullOrWhiteSpace(purpose))
                {
                    <p class="text-muted mb-0">@purpose</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 col-12">
        <nav aria-label="breadcrumb" class="d-flex justify-content-md-end">
            <ol class="breadcrumb breadcrumb-style1 mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                @if (!string.IsNullOrEmpty(subtitle))
                {
                    if (!string.IsNullOrEmpty(subtitleUrl))
                    {
                        <li class="breadcrumb-item"><a href="@subtitleUrl">@subtitle</a></li>
                    }
                    else
                    {
                        <li class="breadcrumb-item">@subtitle</li>
                    }
                }
                <li class="breadcrumb-item active">@title</li>
            </ol>
        </nav>
    </div>
</div>
