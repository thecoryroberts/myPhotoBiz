@model MyPhotoBiz.ViewModels.IndexTableShellViewModel

@if (!Model.HasItems)
{
    if (Model.EmptyContent != null)
    {
        @Model.EmptyContent(null)
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                @if (!string.IsNullOrEmpty(Model.EmptyIcon))
                {
                    <i class="@Model.EmptyIcon fs-1 text-muted"></i>
                }
                <h5 class="mt-3 mb-1">@Model.EmptyTitle</h5>
                @if (!string.IsNullOrEmpty(Model.EmptyMessage))
                {
                    <p class="text-muted mb-0">@Model.EmptyMessage</p>
                }
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="table-responsive text-nowrap">
            <table class="@Model.TableClass">
                @Model.Thead?.Invoke(null)
                @Model.Tbody?.Invoke(null)
            </table>
        </div>
    </div>
}
