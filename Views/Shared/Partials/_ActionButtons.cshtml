@model MyPhotoBiz.ViewModels.ActionButtonsModel

<div class="d-inline-flex align-items-center gap-1">
    @if (Model.ShowView)
    {
        <a asp-controller="@Model.Controller" asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-sm btn-icon btn-outline-info" title="View details" aria-label="View details for @Model.DeleteDataValue">
            <i class="ti ti-eye"></i>
        </a>
    }

    @if (Model.ShowEdit)
    {
        <a asp-controller="@Model.Controller" asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-sm btn-icon btn-outline-primary" title="Edit" aria-label="Edit @Model.DeleteDataValue">
            <i class="ti ti-edit"></i>
        </a>
    }

    @if (Model.ExtraButtons != null)
    {
        @foreach (var btn in Model.ExtraButtons)
        {
            var controller = btn.Controller ?? Model.Controller;
            <a asp-controller="@controller" asp-action="@btn.Action" asp-route-id="@Model.Id"
               class="btn btn-sm btn-icon btn-outline-secondary" title="@btn.Title" aria-label="@btn.Title @Model.DeleteDataValue">
                <i class="@btn.Icon"></i>
            </a>
        }
    }

    @if (Model.ShowDelete)
    {
        <a asp-controller="@Model.Controller" asp-action="Delete" asp-route-id="@Model.Id"
           class="btn btn-sm btn-icon btn-outline-danger delete-btn"
           title="Delete" aria-label="Delete @Model.DeleteDataValue" data-item-name="@Model.DeleteDataValue">
            <i class="ti ti-trash"></i>
        </a>
    }
</div>
