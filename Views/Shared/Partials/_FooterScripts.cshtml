@{
    ViewBag.Purpose = "Shared layout/partial (navigation, scripts, common UI).";
}

<!-- Core scripts (must load first) -->
<script src="~/js/vendors.min.js" asp-append-version="true"></script>
<script src="~/js/app.js" asp-append-version="true"></script>

