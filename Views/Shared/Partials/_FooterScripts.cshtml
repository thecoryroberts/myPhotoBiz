<script src="~/js/form-loading.js" defer asp-append-version="true"></script>
<script src="~/js/field-validation.js" defer asp-append-version="true"></script>
<script src="~/js/sidebar-state.js" defer asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr" defer></script>
<script src="~/js/flatpickr-init.js" defer asp-append-version="true"></script>
