<!DOCTYPE html>

@inject MyPhotoBiz.Services.IAppSettingsService AppSettingsService
@{
    var html_attributes = ViewBag.HTMLAttributes ?? "";
    var html_class = ViewBag.HTMLClass ?? "";
    var data_skin = ViewBag.DataSkin ?? "modern";
    ViewBag.Purpose = "Sneat-aligned application shell layout.";

    var settings = AppSettingsService.GetCachedSettings();
}

<html lang="en" class="@html_class layout-navbar-fixed layout-menu-fixed" data-skin="@data_skin" @html_attributes>
<head>
    @await Html.PartialAsync("~/Views/Shared/Partials/_TitleMeta.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_HeadCSS.cshtml")
    @RenderSection("styles", false)
</head>
<body>
    <div class="layout-wrapper layout-content-navbar wrapper">
        <div class="layout-container">
            @await Html.PartialAsync("~/Views/Shared/Partials/_SideNav.cshtml")

            <div class="layout-page content-page">
                @await Html.PartialAsync("~/Views/Shared/Partials/_TopBar.cshtml")

                <div class="content-wrapper">
                    <main class="container-xxl flex-grow-1 container-p-y" role="main" id="main-content" aria-label="Main content">
                        @await Html.PartialAsync("~/Views/Shared/Partials/_Flash.cshtml")
                        @RenderBody()
                    </main>

                    @await Html.PartialAsync("~/Views/Shared/Partials/_Footer.cshtml")

                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("~/Views/Shared/Partials/_FooterScripts.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_Toasts.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_GlobalSearch.cshtml")

    @RenderSection("scripts", required: false)
</body>
</html>
