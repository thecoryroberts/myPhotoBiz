@{
    ViewData["Title"] = "Welcome";
    ViewBag.Title = "Welcome";
    ViewBag.Icon = "ti ti-home";
    ViewBag.Purpose = "Professional Photography Business Management System";
}

@await Html.PartialAsync("~/Views/Shared/Partials/_PageTitle.cshtml")

<div class="row g-4">
    <div class="col-12">
        <div class="card bg-primary text-white">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h4 class="text-white mb-1">Welcome to MyPhotoBiz</h4>
                    <p class="mb-0 opacity-75">Run bookings, shoots, galleries, contracts, and invoices from one place.</p>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-light">
                        <i class="ti ti-layout-dashboard me-1"></i>Open Dashboard
                    </a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light">
                        <i class="ti ti-login me-1"></i>Sign In
                    </a>
                }
            </div>
        </div>
    </div>

    @if (User.IsInRole("Client"))
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <span class="avatar avatar-xl bg-label-primary rounded-circle mb-3">
                        <i class="ti ti-camera fs-2"></i>
                    </span>
                    <h5 class="mb-2">My Photo Shoots</h5>
                    <p class="text-muted">View your scheduled and completed sessions.</p>
                    <a asp-controller="PhotoShoots" asp-action="MyPhotoShoots" class="btn btn-outline-primary">View Shoots</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <span class="avatar avatar-xl bg-label-success rounded-circle mb-3">
                        <i class="ti ti-photo fs-2"></i>
                    </span>
                    <h5 class="mb-2">Photo Albums</h5>
                    <p class="text-muted">Browse and download delivered photos.</p>
                    <a asp-controller="PhotoShoots" asp-action="MyPhotoShoots" class="btn btn-outline-success">View Albums</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <span class="avatar avatar-xl bg-label-warning rounded-circle mb-3">
                        <i class="ti ti-file-invoice fs-2"></i>
                    </span>
                    <h5 class="mb-2">My Invoices</h5>
                    <p class="text-muted">Track payment status and invoice history.</p>
                    <a asp-controller="Invoices" asp-action="MyInvoices" class="btn btn-outline-warning">View Invoices</a>
                </div>
            </div>
        </div>
    }
    else if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="ti ti-camera me-2 text-primary"></i>For Photographers</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0"><i class="ti ti-check text-success me-2"></i>Manage clients and photo shoots</li>
                        <li class="list-group-item px-0"><i class="ti ti-check text-success me-2"></i>Upload and organize galleries</li>
                        <li class="list-group-item px-0"><i class="ti ti-check text-success me-2"></i>Create contracts and invoices</li>
                        <li class="list-group-item px-0"><i class="ti ti-check text-success me-2"></i>Track revenue and workflow analytics</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="ti ti-users me-2 text-primary"></i>For Clients</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0"><i class="ti ti-check text-primary me-2"></i>View your session timeline</li>
                        <li class="list-group-item px-0"><i class="ti ti-check text-primary me-2"></i>Access and download photos</li>
                        <li class="list-group-item px-0"><i class="ti ti-check text-primary me-2"></i>Review invoices and payment records</li>
                        <li class="list-group-item px-0"><i class="ti ti-check text-primary me-2"></i>Use a secure client portal</li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {}
